# Optional. Leave unset to save progress in the browser (localStorage).
# Set all of these to save characters to your own Firebase project instead
# (enable Anonymous sign-in and Firestore in the Firebase console).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
